{
  "name": "wpcalibrate/wpcalibrate-searchable-pdf-library",
  "description": "Full-text searchable PDF document library for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "WPCalibrate",
      "email": "support@wpcalibrate.com",
      "homepage": "https://wpcalibrate.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "prinsfrank/pdfparser": "^3.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "WPCalibrate\\SearchablePdfLibrary\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPCalibrate\\SearchablePdfLibrary\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "phpunit"
  }
}
